table ecommerce_sales
	lineageTag: cebcd1f6-db72-42f7-bb62-c5e96d047283

	measure 'Total Revenue' = SUM(ecommerce_sales[total_amount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 844dbf25-915f-4540-b55a-ee259f1d872c

	measure 'Total Orders' = COUNT(ecommerce_sales[order_id])
		formatString: 0
		lineageTag: 3b0c3eba-e9c6-4d55-b2d4-a1c0fe69127f

	measure 'Total Customers' = DISTINCTCOUNT(ecommerce_sales[customer_id])
		formatString: 0
		lineageTag: b7882561-1a46-4132-9dbc-454c779c9a4c

	measure 'Average Order Value' =
			
			DIVIDE(
			    [Total Revenue],
			    [Total Orders]
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: b3b3b46c-5b90-404d-9569-28dbf2b475a3

