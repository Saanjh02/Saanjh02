model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Transform File from MavenMarket_Transassctions'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Transform File from MavenMarket_Transassctions\Helper Queries'

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Maven+Market+CSV+Files","Customers","Products","Stores","Calendar","Return_Data","Regions","Transaction_Data","Sample File","Parameter1","Transform Sample File","Transform File"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table Customers
ref table Products
ref table Stores
ref table Calendar
ref table Return_Data
ref table Regions
ref table Transaction_Data

ref cultureInfo en-US

