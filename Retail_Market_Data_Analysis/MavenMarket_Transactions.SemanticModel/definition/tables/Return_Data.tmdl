table Return_Data
	lineageTag: 7d0c4d8b-8df5-4230-91ac-72409f8069f3

	measure 'Quantity Returned' = SUM(Return_Data[quantity])
		formatString: #,0
		displayFolder: Returns
		lineageTag: 4975c7db-b638-41b3-aef1-79e10e8c6f71

	measure 'Total Returns' = COUNTROWS(Return_Data)
		formatString: #,0
		displayFolder: Returns
		lineageTag: 8830684f-cf03-451b-9d59-95eb4d9e5829

	measure 'All Returns' =
			
			CALCULATE(
			    [Total Returns],
			    REMOVEFILTERS()
			)
		formatString: #,0
		displayFolder: Returns
		lineageTag: dcddc686-e3f8-475c-a0c2-c323bb7fb17f

	measure 'Last Month Returns' =
			
			CALCULATE(
			    [Total Returns],
			    DATEADD(Calendar[date], -1, MONTH)
			)
		formatString: #,0
		displayFolder: Returns
		lineageTag: e1ebe8fb-2849-41f8-bf27-12835bbda25d

	/// Percent change in returns vs the previous month. Positive = more returns (worse).
	measure 'Returns vs Last Month %' =
			VAR CurMonth = MAX('Calendar'[Start of Month])
			VAR Cur = CALCULATE([Total Returns], ALL('Calendar'), 'Calendar'[Start of Month] = CurMonth)
			VAR Prev = CALCULATE([Total Returns], ALL('Calendar'), 'Calendar'[Start of Month] = EDATE(CurMonth, -1))
			RETURN DIVIDE(Cur - Prev, Prev)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Returns
		lineageTag: a211c2cf-1310-4c2e-8e86-6da7a6c34a5a

	/// Cost of returned units: quantity returned times product cost.
	measure 'Return Cost' = SUMX(Return_Data, Return_Data[quantity] * RELATED(Products[product_cost]))
		formatString: \$#,0.00
		displayFolder: Returns
		lineageTag: 1c5097f1-5738-4791-bea4-c8fc06293f71

	column return_date
		dataType: dateTime
		formatString: m/d/yyyy
		lineageTag: 00ddab65-b3fa-4cc4-94df-72c67a63537a
		summarizeBy: none
		sourceColumn: return_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column product_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fbaff72f-af3a-4e5a-b758-faf338f033a6
		summarizeBy: none
		sourceColumn: product_id

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column store_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2506d881-7af8-4f69-83a7-12725047c70f
		summarizeBy: none
		sourceColumn: store_id

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column quantity
		dataType: int64
		formatString: 0
		lineageTag: 9143beab-9b8a-478f-aa07-026ad48676dc
		summarizeBy: none
		sourceColumn: quantity

		annotation SummarizationSetBy = Automatic

	partition Return_Data = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Deepak Sharma\Documents\Sunita\sql\MavenMarket_Returns_1997-1998.csv"),[Delimiter=",", Columns=4, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"return_date", type date}, {"product_id", Int64.Type}, {"store_id", Int64.Type}, {"quantity", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

