		sourceColumn: discount_price

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column Price_Tier =
			
			IF(
			    'Products'[product_retail_price] > 3,
			    "High",
			    IF(
			        'Products'[product_retail_price] > 1,
			        "Mid",
			        "Low"
			    )
			)
		lineageTag: 3c7b52d2-69b7-450d-aa40-1f258ba418b4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

