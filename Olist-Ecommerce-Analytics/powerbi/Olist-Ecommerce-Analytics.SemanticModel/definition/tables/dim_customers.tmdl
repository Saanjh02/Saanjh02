table dim_customers
	lineageTag: a62afb6d-da3a-4621-b212-8cca26f3a85d

	measure 'Repeat Customers' = ```
			CALCULATE(DISTINCTCOUNT(dim_customers[customer_unique_id]),
			                   dim_customers[is_repeat_customer] = TRUE
			)
			
			```
		formatString: #,0
